# Local dev: omit to use a local SQLite file (./moneybook.db).
# Production: set to your Turso database URL/token.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

AUTH_SECRET=

AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

AUTH_NAVER_ID=
AUTH_NAVER_SECRET=

# Comma-separated list of emails allowed to sign in.
ALLOWED_EMAILS=

# 분석 버튼. Omit and the button does not render at all — the screens
# that would carry it simply do not, rather than offering an action the
# deployment cannot perform.
ANTHROPIC_API_KEY=
